---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { navLinks } from '../data/home';

const pageTitle = 'Contact Us | NEC Ltd Electrical';
const pageDescription =
	'Contact NEC Ltd Electrical to discuss design and build electrical services. Submit an enquiry, call, email, or visit us in Kettering.';

const pageLinks = navLinks.map((link) => ({
	...link,
	href: link.href.startsWith('/') ? link.href : `/${link.href}`,
}));
---

<Layout title={pageTitle} description={pageDescription}>
	<Header links={pageLinks} />

	<main id="main-content">
		<section class="contact-hero">
			<div class="contact-hero-bg" aria-hidden="true"></div>
			<div class="contact-hero-overlay" aria-hidden="true"></div>
			<div class="container contact-hero-content">
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href="/">Home</a>
					<span aria-hidden="true">›</span>
					<span aria-current="page">Contact</span>
				</nav>
				<h1>Get in touch about your project today</h1>
				<p>
					Whether you are planning a new build, refurbishment, or specialist electrical scope, our team is ready
					to talk through requirements, programme, and budget.
				</p>
			</div>
		</section>

		<ContactSection />
	</main>

	<Footer links={pageLinks} />
</Layout>

<style>
	.contact-hero {
		position: relative;
		min-height: clamp(320px, 48vh, 420px);
		overflow: clip;
		display: grid;
		align-items: end;
	}

	.contact-hero-bg,
	.contact-hero-overlay {
		position: absolute;
		inset: 0;
	}

	.contact-hero-bg {
		background: center / cover no-repeat url('/images/hero-1.jpg');
	}

	.contact-hero-overlay {
		background: linear-gradient(130deg, rgba(17, 22, 35, 0.88), rgba(17, 22, 35, 0.52));
	}

	.contact-hero-content {
		position: relative;
		z-index: 1;
		color: var(--white);
		padding-bottom: clamp(2rem, 4vw, 2.8rem);
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.42rem;
		font: 400 0.88rem/1.2 'League Spartan', Arial, sans-serif;
		color: rgba(255, 255, 255, 0.82);
	}

	.crumbs a {
		color: rgba(255, 255, 255, 0.86);
	}

	.crumbs a:hover {
		color: var(--white);
	}

	h1 {
		margin-top: 0.85rem;
		font-size: clamp(2.1rem, 6vw, 3.8rem);
		line-height: 0.98;
		letter-spacing: -0.03em;
		color: var(--white);
		max-width: 16ch;
	}

	.contact-hero-content p:last-child {
		margin-top: 1rem;
		max-width: 58ch;
		color: #dde1ee;
		line-height: 1.65;
	}
</style>
