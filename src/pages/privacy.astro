---
import LegalLayout from '../layouts/LegalLayout.astro';
---

<LegalLayout
	title="Privacy Policy | NEC Ltd Electrical"
	description="How NEC Ltd Electrical collects, uses, and protects personal data submitted through this website and project enquiries."
	canonicalPath="/privacy/"
	heading="Privacy Policy"
	intro="This policy explains how NEC Ltd Electrical handles personal information when you contact us or use this website."
	sections={[
		{
			title: 'Who we are',
			paragraphs: [
				'NEC Ltd Electrical is a NICEIC Approved Contractor based at 81A Charles Street, Kettering, Northamptonshire, NN16 9RL.',
				'For privacy enquiries, contact us at enquries@necltd.net or 01536 417 807.',
			],
		},
		{
			title: 'Information we collect',
			paragraphs: [
				'We may collect your name, company, email address, phone number, and project details when you submit a contact or enquiry form.',
				'We also collect basic technical data such as browser type and pages visited through standard server logs. If you accept analytics cookies, our Stat Monitor analytics service (privacy-focused, no advertising tracking) records anonymised page views to help us improve the website.',
			],
		},
		{
			title: 'Analytics',
			paragraphs: [
				'We use Stat Monitor (Plausible analytics hosted at dotwallstats.co.uk) to understand how visitors use this website. It is only activated if you accept analytics in our cookie banner. We do not use this data for advertising or sell it to third parties.',
			],
		},
		{
			title: 'How we use your information',
			paragraphs: [
				'We use enquiry details to respond to your request, scope projects, and provide quotations or follow-up communication related to our services.',
				'We do not sell personal data. We only share information with trusted processors where necessary to operate the website or deliver our services.',
			],
		},
		{
			title: 'Your rights',
			paragraphs: [
				'You may request access, correction, or deletion of your personal data, or object to certain processing, by contacting us using the details above.',
				'You also have the right to complain to the ICO if you believe your data has not been handled appropriately.',
			],
		},
	]}
/>
