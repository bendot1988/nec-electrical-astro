---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
import ServicesSection from '../../components/ServicesSection.astro';
import { navLinks, serviceCards } from '../../data/home';

const pageTitle = 'Services | NEC Ltd Electrical';
const pageDescription =
	'Browse NEC electrical services — design and technical, power, lighting, security and data communications from a NICEIC Approved Contractor.';
const homeAnchors = navLinks.map((link) => ({
	...link,
	href: link.href.startsWith('/') ? link.href : `/${link.href}`,
}));
---

<Layout
	title={pageTitle}
	description={pageDescription}
	ogImage="/images/service-power-hero.png"
>
	<main id="main-content">
		<PageHero links={homeAnchors} image="/images/service-power-hero.png" imagePosition="center 35%">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span aria-hidden="true">›</span>
				<span aria-current="page">Services</span>
			</nav>
			<h1>Our Services</h1>
			<p class="hero-sub">
				Complete design and build electrical services — from initial surveys and technical design through to
				installation, testing, and handover.
			</p>
		</PageHero>

		<ServicesSection services={serviceCards} showFilter={false} />

		<section class="section cta-band">
			<div class="container cta-inner" data-animate="fade-up">
				<div class="cta-copy">
					<h2>Need something outside our standard services?</h2>
					<p>Tell us about bespoke scopes and we will scope a tailored electrical solution.</p>
				</div>
				<a href="/custom-electrical-work/" class="btn btn-primary">Custom electrical work</a>
			</div>
		</section>
	</main>

	<Footer links={homeAnchors} />
</Layout>

<style>
	.cta-band {
		background: linear-gradient(135deg, #0a122a 0%, #0d1b40 100%);
	}

	.cta-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.cta-copy h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		color: var(--white);
		letter-spacing: -0.02em;
	}

	.cta-copy p {
		margin-top: 0.55rem;
		color: rgba(255, 255, 255, 0.78);
		max-width: 48ch;
	}
</style>
