---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
import { navLinks, serviceCards } from '../../data/home';
import { formatNewsDate, getNewsHref, getSortedNewsArticles, newsArticles } from '../../data/news';

export function getStaticPaths() {
	return newsArticles.map((article) => ({
		params: { slug: article.slug },
		props: { article },
	}));
}

const { article } = Astro.props;

const pageLinks = navLinks.map((link) => ({
	...link,
	href: link.href.startsWith('/') ? link.href : `/${link.href}`,
}));

const pageTitle = `${article.title} | News | NEC Ltd Electrical`;
const pageDescription = article.excerpt;

const relatedArticles = getSortedNewsArticles()
	.filter((item) => item.slug !== article.slug)
	.slice(0, 2);
---

<Layout title={pageTitle} description={pageDescription} ogImage={article.image}>
	<main id="main-content" class="news-page">
		<article class="article">
			<PageHero links={pageLinks} image={article.image}>
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href="/">Home</a>
					<span aria-hidden="true">›</span>
					<a href="/news/">News</a>
					<span aria-hidden="true">›</span>
					<span aria-current="page">{article.title}</span>
				</nav>
				<p class="hero-meta">
					<time datetime={article.publishedAt}>{formatNewsDate(article.publishedAt)}</time>
					<span aria-hidden="true">·</span>
					<span>{article.readTime}</span>
				</p>
				<h1>{article.title}</h1>
			</PageHero>

			<div class="container article-layout">
				<div class="article-main" data-animate="fade-up">
					<aside class="article-summary brand-line-box" aria-label="Summary">
						<p class="summary-kicker">Summary</p>
						<p class="summary-text">{article.excerpt}</p>
					</aside>

					<div class="article-body">
						{
							article.paragraphs.map((paragraph) =>
								typeof paragraph === 'string' ? <p>{paragraph}</p> : <p set:html={paragraph.html} />,
							)
						}
					</div>

					<figure class="article-feature brand-line-box">
						<img
							src={article.image}
							alt={article.slug === 'new-nec-website-launch'
								? 'Screenshot of the new NEC Ltd Electrical website homepage'
								: article.title}
							loading="lazy"
							width="1200"
							height="800"
						/>
					</figure>
				</div>

				<aside class="article-sidebar" data-animate="fade-up" data-animate-delay="0.08">
					{
						relatedArticles.length > 0 && (
							<div class="sidebar-block">
								<h2 class="sidebar-title">Related articles</h2>
								<ul class="sidebar-news-list">
									{relatedArticles.map((related) => (
										<li>
											<a class="sidebar-news-link" href={getNewsHref(related.slug)}>
												<img src={related.image} alt="" loading="lazy" width="120" height="80" />
												<span class="sidebar-news-copy">
													<span class="sidebar-news-title">{related.title}</span>
													<span class="sidebar-news-meta">{related.readTime}</span>
												</span>
											</a>
										</li>
									))}
								</ul>
								<a href="/news/" class="sidebar-text-link">View all news</a>
							</div>
						)
					}

					<div class="sidebar-block">
						<h2 class="sidebar-title">Our services</h2>
						<ul class="sidebar-link-list">
							<li><a href="/services/">Services overview</a></li>
							{
								serviceCards.map((service) => (
									<li>
										<a href={service.href ?? '/services/'}>{service.title}</a>
									</li>
								))
							}
						</ul>
					</div>

					<div class="sidebar-block sidebar-cta brand-line-box">
						<h2 class="sidebar-title">Discuss your project</h2>
						<p>Tell us about your scope, location, and programme — we will come back to you promptly.</p>
						<a href="/contact/" class="btn btn-primary">Contact us</a>
					</div>
				</aside>
			</div>
		</article>
	</main>

	<Footer links={pageLinks} />
</Layout>

<style>
	.news-page {
		background: var(--white);
	}

	.article-layout {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 3vw, 2.5rem);
		align-items: start;
		padding-block: clamp(2.5rem, 5vw, 4rem);
	}

	.article-main {
		min-width: 0;
	}

	.article-summary {
		margin: 0 0 1.75rem;
		padding: 1.15rem 1.2rem;
		background: var(--ghost-white);
		border-left: 4px solid var(--blue);
		clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%);
	}

	.summary-kicker {
		margin: 0;
		font: 600 0.73rem/1 'Open Sans', Arial, sans-serif;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--blue);
	}

	.summary-text {
		margin: 0.55rem 0 0;
		font-size: 1.08rem;
		line-height: 1.6;
		color: var(--charcoal-100);
	}

	.article-feature {
		margin: 2rem 0 0;
		background: var(--ghost-white);
		clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);
		box-shadow: 0 12px 28px rgba(21, 27, 44, 0.08);
		overflow: hidden;
	}

	.article-feature img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: contain;
		object-position: center;
		background: var(--ghost-white);
	}

	.article-body {
		max-width: 68ch;
	}

	.article-body p {
		color: var(--charcoal-300);
		line-height: 1.75;
	}

	.article-body p + p {
		margin-top: 1rem;
	}

	.article-body :global(a) {
		color: var(--blue);
		font-weight: 600;
	}

	.article-body :global(a:hover) {
		text-decoration: underline;
	}

	.article-sidebar {
		position: sticky;
		top: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.sidebar-block {
		background: var(--ghost-white);
		padding: 1.15rem;
		clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%);
	}

	.sidebar-title {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.sidebar-news-list {
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.sidebar-news-link {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 0.7rem;
		align-items: start;
	}

	.sidebar-news-link:hover .sidebar-news-title {
		color: var(--blue);
	}

	.sidebar-news-link img {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 0 100%);
	}

	.sidebar-news-copy {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.sidebar-news-title {
		font: 600 0.92rem/1.3 'League Spartan', Arial, sans-serif;
		color: var(--charcoal-100);
		transition: color 0.2s var(--motion-ease);
	}

	.sidebar-news-meta {
		font: 400 0.8rem/1.3 'Open Sans', Arial, sans-serif;
		color: var(--charcoal-400);
	}

	.sidebar-text-link {
		display: inline-block;
		margin-top: 0.85rem;
		font: 600 0.9rem/1 'League Spartan', Arial, sans-serif;
		color: var(--blue);
	}

	.sidebar-text-link:hover {
		text-decoration: underline;
	}

	.sidebar-link-list {
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.sidebar-link-list a {
		font: 400 0.92rem/1.45 'Open Sans', Arial, sans-serif;
		color: var(--charcoal-300);
	}

	.sidebar-link-list a:hover {
		color: var(--blue);
	}

	.sidebar-cta p {
		margin-top: 0.55rem;
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--charcoal-400);
	}

	.sidebar-cta .btn {
		margin-top: 0.9rem;
		width: 100%;
		justify-content: center;
		clip-path: none;
		border-radius: 10px;
	}

	@media (max-width: 900px) {
		.article-layout {
			grid-template-columns: 1fr;
		}

		.article-sidebar {
			position: static;
		}
	}
</style>
