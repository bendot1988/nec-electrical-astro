---
import LegalLayout from '../layouts/LegalLayout.astro';
---

<LegalLayout
	title="Cookie Policy | NEC Ltd Electrical"
	description="Details of cookies and similar technologies used on the NEC Ltd Electrical website, and how you can manage your preferences."
	canonicalPath="/cookies/"
	heading="Cookie Policy"
	intro="This page explains how cookies are used on the NEC Ltd Electrical website and how you can control them."
	sections={[
		{
			title: 'What are cookies?',
			paragraphs: [
				'Cookies are small text files stored on your device when you visit a website. They help the site function correctly and, where you consent, allow us to understand how the site is used.',
			],
		},
		{
			title: 'Essential cookies',
			paragraphs: [
				'These cookies are required for core site functionality, including remembering your cookie consent choice. They do not track you across other websites.',
			],
		},
		{
			title: 'Analytics cookies',
			paragraphs: [
				'If you choose “Accept analytics” on our cookie banner, we load Stat Monitor (monitor.dotwall.co.uk) to help us understand page views and general traffic patterns without advertising profiles or cross-site tracking.',
				'The analytics script is blocked until you consent. If you choose “Essential only”, analytics cookies and scripts are not loaded.',
			],
		},
		{
			title: 'Managing cookies',
			paragraphs: [
				'Use the cookie banner on your first visit to accept or decline analytics. To change your choice later, click “Cookie settings” in the website footer — the banner will appear again.',
				'You can also control or delete cookies through your browser settings. Essential cookies required for the site to operate cannot be disabled without affecting how the site works.',
				'For more detail on how we handle personal data, see our privacy policy.',
			],
		},
	]}
/>
