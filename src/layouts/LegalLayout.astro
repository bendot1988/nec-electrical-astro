---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { navLinks } from '../data/home';

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
	heading: string;
	intro: string;
	sections: { title: string; paragraphs: string[] }[];
}

const { title, description, canonicalPath, heading, intro, sections } = Astro.props;
const pageLinks = navLinks.map((link) => ({
	...link,
	href: link.href.startsWith('/') ? link.href : `/${link.href}`,
}));
---

<Layout title={title} description={description}>
	<Header links={pageLinks} />

	<main id="main-content">
		<section class="legal-hero">
			<div class="container legal-hero-content">
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href="/">Home</a>
					<span aria-hidden="true">›</span>
					<span aria-current="page">{heading}</span>
				</nav>
				<h1>{heading}</h1>
				<p>{intro}</p>
			</div>
		</section>

		<section class="section legal-content">
			<div class="container legal-copy">
				{
					sections.map((section) => (
						<section>
							<h2>{section.title}</h2>
							{section.paragraphs.map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</section>
					))
				}
			</div>
		</section>
	</main>

	<Footer links={pageLinks} />
</Layout>

<style>
	.legal-hero {
		padding: 7.5rem 0 2.5rem;
		background: linear-gradient(140deg, #101528, #1a2140);
		color: var(--white);
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.42rem;
		font: 400 0.88rem/1.2 'League Spartan', Arial, sans-serif;
		color: rgba(255, 255, 255, 0.82);
	}

	.crumbs a {
		color: rgba(255, 255, 255, 0.86);
	}

	h1 {
		margin-top: 0.85rem;
		font-size: clamp(2rem, 5vw, 3.2rem);
		color: var(--white);
	}

	.legal-hero p {
		margin-top: 1rem;
		max-width: 62ch;
		color: rgba(255, 255, 255, 0.82);
	}

	.legal-content {
		background: var(--ghost-white);
	}

	.legal-copy {
		max-width: 72ch;
		display: grid;
		gap: 2rem;
	}

	.legal-copy h2 {
		font-size: 1.55rem;
		margin-bottom: 0.75rem;
	}

	.legal-copy p + p {
		margin-top: 0.85rem;
	}
</style>
