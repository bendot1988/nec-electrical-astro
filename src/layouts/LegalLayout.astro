---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import { navLinks } from '../data/home';

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
	heading: string;
	intro: string;
	sections: { title: string; paragraphs: string[] }[];
}

const { title, description, canonicalPath, heading, intro, sections } = Astro.props;
const pageLinks = navLinks.map((link) => ({
	...link,
	href: link.href.startsWith('/') ? link.href : `/${link.href}`,
}));
---

<Layout title={title} description={description}>
	<main id="main-content">
		<PageHero links={pageLinks} size="compact">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span aria-hidden="true">›</span>
				<span aria-current="page">{heading}</span>
			</nav>
			<h1>{heading}</h1>
			<p>{intro}</p>
		</PageHero>

		<section class="section legal-content">
			<div class="container legal-copy">
				{
					sections.map((section) => (
						<section>
							<h2>{section.title}</h2>
							{section.paragraphs.map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</section>
					))
				}
			</div>
		</section>
	</main>

	<Footer links={pageLinks} />
</Layout>

<style>
	.legal-content {
		background: var(--ghost-white);
	}

	.legal-copy {
		max-width: 72ch;
		display: grid;
		gap: 2rem;
	}

	.legal-copy h2 {
		font-size: 1.55rem;
		margin-bottom: 0.75rem;
	}

	.legal-copy p + p {
		margin-top: 0.85rem;
	}
</style>
